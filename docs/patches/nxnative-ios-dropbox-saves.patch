+#!/usr/bin/env python3
+# DropboxSaves.m on the Mac against a local stand-in for Dropbox: no account, no real token. Run: python3 dm/ios/tests/test_dropbox_saves.py
+import http.server, json, os, pathlib, subprocess, sys, tempfile, threading, urllib.parse
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+TITLE = '0100000000DM5A9C'
+PATH = f'/Saves/{TITLE}/save.dmsync'
+REFRESH, ACCESS = 'refresh-SECRET-1', 'access-SECRET-2'
+HARNESS = r'''
+#import "DropboxSaves.h"
+#include "save_sync.h"
+int main(int c, char **v) {
+    if (!strcmp(v[1], "enabled")) { printf("%d\n", dm_dropbox_enabled()); return 0; }
+    dm_dropbox_enabled();
+    if (!strcmp(v[1], "fetch")) { int r = dm_dropbox_fetch("x", v[2]); printf("%d\n", r); return 0; }
+    if (!strcmp(v[1], "store")) { printf("%d\n", dm_dropbox_store(v[2], "x")); return 0; }
+    if (!strcmp(v[1], "check")) {
+        __block int done = 0;
+        dm_dropbox_check(^(NSInteger s, NSString *t) { printf("%ld\n%s\n", (long)s, t.UTF8String); done = 1; });
+        while (!done) [NSRunLoop.mainRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]];
+        printf("then %d\n", dm_dropbox_fetch("x", v[2]));
+        printf("after %d\n", dm_dropbox_fetch("x", v[3]));
+        return 0;
+    }
+    return 2;
+}
+'''
+
+
+class Dropbox(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *a): pass
+
+    def reply(self, code, body=b'', **headers):
+        self.send_response(code)
+        for k, v in headers.items(): self.send_header(k, v)
+        self.send_header('Content-Length', str(len(body))); self.end_headers(); self.wfile.write(body)
+
+    def do_POST(self):
+        s = self.server
+        data = self.rfile.read(int(self.headers.get('Content-Length', 0)))
+        s.seen.append(self.path)
+        if self.path == '/redirected': s.redirected = dict(self.headers); return self.reply(200, b'x')
+        if self.path == '/oauth2/token':
+            f = urllib.parse.parse_qs(data.decode())
+            s.tokens += 1
+            if f.get('refresh_token') != [REFRESH] or f.get('client_id') != ['key'] or f.get('grant_type') != ['refresh_token'] or s.mode == 'noauth': return self.reply(400, b'{}')
+            return self.reply(200, json.dumps({'access_token': ACCESS, 'expires_in': 14400}).encode())
+        if self.headers.get('Authorization') != 'Bearer ' + ACCESS: return self.reply(401, b'{}')
+        if s.mode == 'expired-once': s.mode = ''; return self.reply(401, b'{}')
+        if s.mode == 'redirect': return self.reply(302, Location=f'http://127.0.0.1:{s.server_port}/redirected')
+        if s.mode == 'error': return self.reply(500, b'{}')
+        arg = json.loads(self.headers['Dropbox-API-Arg'])
+        s.args.append(arg)
+        if self.path == '/2/files/download':
+            if arg['path'] not in s.files: return self.reply(409, b'{"error_summary": "path/not_found/.."}')
+            if s.mode == 'other409': return self.reply(409, b'{"error_summary": "path/restricted_content/.."}')
+            return self.reply(200, s.files[arg['path']])
+        if self.path == '/2/files/upload': s.files[arg['path']] = data; return self.reply(200, b'{}')
+        self.reply(404)
+
+
+class T:
+    fails = 0
+    def eq(self, got, want, what):
+        ok = got == want
+        print(('ok   ' if ok else 'FAIL ') + what + ('' if ok else f': got {got!r}, want {want!r}'))
+        self.fails += not ok
+
+
+def bundle(title=TITLE, payload=b'hello'):   # a valid packed save (save_sync.c's format, device and date fixed)
+    import hashlib, struct
+    T0 = 1767315845; p = b'save/a.bin'
+    h = struct.pack('<BBHHHQq', 2, 0, len(p), 0, 0, len(payload), T0)
+    digest = hashlib.sha256(h[:16] + p + payload).hexdigest()[:32].encode()
+    return b'DMSYNC1\n' + struct.pack('<II', 1, 1) + digest + struct.pack('<q', T0) + title.encode().ljust(24, b'\0') + b'NP05J'.ljust(64, b'\0') + h + p + payload + b'DMSYNCE\n'
+
+
+def main():
+    t = T()
+    srv = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Dropbox)
+    srv.seen, srv.args, srv.files, srv.mode, srv.tokens, srv.redirected = [], [], {}, '', 0, None
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    url = f'http://127.0.0.1:{srv.server_port}'
+    d = pathlib.Path(tempfile.mkdtemp(prefix='dropbox-saves-'))
+    src = ROOT / 'dm/ios/Sources'
+    (d / 'h.m').write_text(HARNESS)
+    subprocess.run(['clang', '-fobjc-arc', '-Wall', '-Werror', '-Wno-unused-function', f'-I{src}', f'-I{ROOT}/dm/host', f'-DDM_GAME_ID="{TITLE.lower()}"', f'-DDM_DROPBOX_API="{url}"', f'-DDM_DROPBOX_CONTENT="{url}"',
+                    '-framework', 'Foundation', str(d / 'h.m'), str(src / 'DropboxSaves.m'), str(ROOT / 'dm/host/save_sync.c'), '-o', str(d / 'h')], check=True)
+    home = d / 'home'; (home / 'Documents').mkdir(parents=True); (home / 'Library').mkdir()
+    save = d / 'save'; save.mkdir()
+    log = []
+
+    def run(*a):
+        env = {**os.environ, 'CFFIXED_USER_HOME': str(home), 'DM_SAVE': str(save)}; env.pop('DM_SAVE_SYNC', None)
+        r = subprocess.run([str(d / 'h'), *a], capture_output=True, text=True, env=env, timeout=120)
+        log.append(r.stdout + r.stderr)
+        return r.stdout.split('\n')[0], r
+
+    t.eq(run('enabled')[0], '0', 'off without dropbox.txt')
+    (home / 'Documents/dropbox.txt').write_text('# bad\nrefresh_token=only\n')
+    t.eq(run('enabled')[0], '0', 'a bad file is refused')
+    t.eq((home / 'Documents/dropbox.txt').exists(), True, '... and left in place')
+    (home / 'Documents/dropbox.txt').write_text(f'# comment\napp_key=key\nrefresh_token={REFRESH}\n')
+    t.eq(run('enabled')[0], '1', 'on with dropbox.txt')
+    t.eq((home / 'Documents/dropbox.txt').exists(), False, 'dropbox.txt leaves Documents')
+    conf = home / 'Library/dropbox-saves/dropbox.conf'
+    t.eq(oct(conf.stat().st_mode & 0o777), '0o600', 'the settings are private')
+    t.eq(run('enabled')[0], '1', 'still on at the next start')
+
+    out, buf = d / 'o', bundle()
+    t.eq(run('fetch', str(out))[0], '0', 'no file in Dropbox is 0')
+    srv.files[PATH] = buf
+    t.eq(run('fetch', str(out))[0], '1', 'download')
+    t.eq(out.read_bytes(), buf, '... the same bytes')
+    t.eq(srv.args[-1]['path'], PATH, '... from <folder>/<TITLE>/save.dmsync')
+    srv.mode = 'other409'; t.eq(run('fetch', str(out))[0], '-1', 'another 409 is a failure, not "none"')
+    srv.mode = 'error'; t.eq(run('fetch', str(out))[0], '-1', 'a server error is -1')
+    srv.mode = 'noauth'; t.eq(run('fetch', str(out))[0], '-1', 'no token is -1')
+    srv.mode = 'expired-once'; t.eq(run('fetch', str(out))[0], '1', 'a refused token is renewed once')
+    srv.mode = 'redirect'; t.eq(run('fetch', str(out))[0], '-1', 'a redirect is a failure')
+    t.eq(srv.redirected, None, '... and is not followed with the token')
+    srv.mode = ''
+
+    up = d / 'u'; up.write_bytes(b'new')
+    t.eq(run('store', str(up))[0], '1', 'upload')
+    t.eq((srv.files[PATH], srv.args[-1]['mode'], srv.args[-1]['autorename']), (b'new', 'overwrite', False), '... replaces the file')
+    srv.mode = 'error'; t.eq(run('store', str(up))[0], '0', 'a failed upload is 0'); srv.mode = ''
+
+    a, b = d / 'a', d / 'b'
+    srv.files[PATH] = buf
+    _, r = run('check', str(a), str(b))
+    lines = r.stdout.split('\n')
+    t.eq(lines[0], '1', 'check: a valid save')
+    t.eq('NP05J' in r.stdout, True, '... names the device')
+    t.eq('then 1' in r.stdout and a.read_bytes() == buf, True, '... the first mount takes what the check downloaded')
+    t.eq('after 1' in r.stdout, True, '... later looks go to Dropbox')
+    del srv.files[PATH]
+    _, r = run('check', str(a), str(b)); t.eq((r.stdout.split('\n')[0], 'then 0' in r.stdout), ('0', True), 'check: none in the cloud')
+    srv.files[PATH] = buf[:-3]
+    _, r = run('check', str(a), str(b)); t.eq((r.stdout.split('\n')[0], 'then -1' in r.stdout), ('-1', True), 'check: a cut-off file cannot be read')
+    srv.files[PATH] = bundle(title='0100000000000000')
+    _, r = run('check', str(a), str(b)); t.eq(r.stdout.split('\n')[0], '-1', "check: another game's file cannot be read")
+    srv.mode = 'error'
+    _, r = run('check', str(a), str(b)); t.eq((r.stdout.split('\n')[0], 'then -1' in r.stdout), ('-1', True), 'check: Dropbox unreachable')
+    srv.mode = ''
+
+    text = ''.join(log)
+    t.eq(REFRESH in text or ACCESS in text, False, 'neither token is ever printed')
+    if t.fails: sys.exit(f'{t.fails} failed')
+    print('all passed')
+
+
+if __name__ == '__main__':
+    main()
