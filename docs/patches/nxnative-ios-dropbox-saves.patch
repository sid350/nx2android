+++ b/dm/ios/Sources/DropboxSaves.h
@@ -0,0 +1,32 @@
+// Cloud saves straight through the Dropbox API (a local patch, not in upstream). The Dropbox app's folder in Files can hand back an old copy of a file changed on another device, so with
+// settings present the iPhone reads and writes save.dmsync on Dropbox's servers itself; save_sync.c still packs, compares, decides and keeps the backups. The files stay in the same folder.
+// Off unless Documents/dropbox.txt has been put in (KEY=VALUE per line, # comments), the file nx2android's devtools/dropbox_token.py writes:
+//   app_key=...         the Dropbox app the token was given to
+//   refresh_token=...   stands for the player's account: treated as a password
+//   folder=/Saves       optional: the folder holding <title ID>/save.dmsync, from the root of the app's folder
+// The file is moved at once to Library (out of Files and of device backups). Neither token is ever logged. DM_SAVE_SYNC=0 in env.txt turns sync off.
+#import <Foundation/Foundation.h>
+#if __has_include(<UIKit/UIKit.h>)
+#import <UIKit/UIKit.h>
+#endif
+
+NS_ASSUME_NONNULL_BEGIN
+
+/// Takes in dropbox.txt and sets DM_SAVE_SYNC; NO when Dropbox saves are off.
+BOOL dm_dropbox_enabled(void);
+
+/// Asks Dropbox now, on a queue of its own: what the launcher shows beside Play. `done` runs on the main thread. state: 1 a valid cloud save, 0 none in the cloud, -1 cannot be read.
+/// The save it downloaded is the one the game's first save mount takes, so the mount does not wait for the network again.
+void dm_dropbox_check(void (^done)(NSInteger state, NSString *text));
+
+/// front_save_sync_fetch and front_save_sync_store (SaveSync.m) when Dropbox saves are on.
+int dm_dropbox_fetch(const char *cloud, const char *local);
+int dm_dropbox_store(const char *local, const char *cloud);
+
+#if __has_include(<UIKit/UIKit.h>)
+/// At Play (startGame): asks Dropbox once more and, when the save cannot be read, asks the player whether to start anyway. YES = go on now; NO = it has taken over, and calls `go` (start the
+/// game) or `back` (the player said no) on the main thread.
+BOOL dm_dropbox_gate(UIViewController *vc, void (^go)(void), void (^back)(void));
+#endif
+
+NS_ASSUME_NONNULL_END
diff --git a/dm/ios/Sources/DropboxSaves.m b/dm/ios/Sources/DropboxSaves.m
new file mode 100644
index 00000000..32c887f7
--- /dev/null
+++ b/dm/ios/Sources/DropboxSaves.m
@@ -0,0 +1,272 @@
+// See DropboxSaves.h. Foundation only, apart from the dialog at Play, so dm/ios/tests/test_dropbox_saves.py runs the rest on the Mac against a local server.
+#import "DropboxSaves.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "save_sync.h"
+#ifndef DM_GAME_ID
+#include "game_profile.h"
+#endif
+
+#ifndef DM_DROPBOX_API
+#define DM_DROPBOX_API "https://api.dropboxapi.com"
+#endif
+#ifndef DM_DROPBOX_CONTENT
+#define DM_DROPBOX_CONTENT "https://content.dropboxapi.com"
+#endif
+#define DBLOG(...) do { fprintf(stderr, "[dm] save sync: " __VA_ARGS__); fputc('\n', stderr); } while (0)
+#define DBRED(...) do { fprintf(stderr, "[dm] [RED] save sync: " __VA_ARGS__); fputc('\n', stderr); } while (0)
+static const NSTimeInterval REQUEST_S = 15, RESOURCE_S = 60;
+enum { PRE_NONE = -2 };
+
+static NSString *g_app_key, *g_refresh, *g_folder = @"/Saves", *g_dir, *g_access;
+static NSDate *g_access_until;
+static BOOL g_on;
+static NSInteger g_pre = PRE_NONE;   // what the last check left for the first save mount: 1 the file below, 0 none in the cloud, -1 cannot be read
+static NSString *g_pre_file;
+
+static NSString *L(NSString *en, NSString *ru) { return [NSLocale.preferredLanguages.firstObject hasPrefix:@"ru"] ? ru : en; }
+
+// ---------- the settings ----------
+static BOOL value_ok(NSString *v) {
+    for (NSUInteger i = 0; i < v.length; i++) { unichar c = [v characterAtIndex:i]; if (c <= 0x20 || c == 0x7f || c == '"' || c == '\\' || c == '&') return NO; }
+    return YES;
+}
+
+static BOOL conf_read(NSString *path) {   // never logs a line: it may hold the token
+    NSString *text = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
+    if (!text) return NO;
+    NSString *key = nil, *refresh = nil, *folder = @"/Saves";
+    for (NSString *raw in [text componentsSeparatedByCharactersInSet:NSCharacterSet.newlineCharacterSet]) {
+        NSString *ln = [raw stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+        NSRange eq = [ln rangeOfString:@"="];
+        if ([ln hasPrefix:@"#"] || eq.location == NSNotFound) continue;
+        NSString *k = [ln substringToIndex:eq.location], *v = [ln substringFromIndex:eq.location + 1];
+        if (!value_ok(v)) return NO;
+        if ([k isEqualToString:@"app_key"]) key = v;
+        else if ([k isEqualToString:@"refresh_token"]) refresh = v;
+        else if ([k isEqualToString:@"folder"]) folder = v;
+    }
+    while ([folder hasSuffix:@"/"]) folder = [folder substringToIndex:folder.length - 1];
+    if (!key.length || !refresh.length || (folder.length && ![folder hasPrefix:@"/"])) return NO;
+    g_app_key = key; g_refresh = refresh; g_folder = folder;
+    return YES;
+}
+
+static void setup(void) {
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSString *lib = NSSearchPathForDirectoriesInDomains(NSLibraryDirectory, NSUserDomainMask, YES)[0], *doc = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES)[0];
+    g_dir = [lib stringByAppendingPathComponent:@"dropbox-saves"];
+    NSString *conf = [g_dir stringByAppendingPathComponent:@"dropbox.conf"], *from = [doc stringByAppendingPathComponent:@"dropbox.txt"];
+    NSDictionary *only_me = @{NSFilePosixPermissions: @0700, NSFileProtectionKey: NSFileProtectionCompleteUntilFirstUserAuthentication};
+    [fm createDirectoryAtPath:g_dir withIntermediateDirectories:YES attributes:only_me error:nil];
+    NSURL *dir = [NSURL fileURLWithPath:g_dir]; [dir setResourceValue:@YES forKey:NSURLIsExcludedFromBackupKey error:nil];
+    if ([fm fileExistsAtPath:from]) {
+        if (!conf_read(from)) DBRED("Documents/dropbox.txt has no app_key and refresh_token (or a bad value): it was not taken");
+        else {
+            NSString *tmp = [conf stringByAppendingString:@".new"];
+            [fm removeItemAtPath:tmp error:nil];
+            BOOL ok = [fm copyItemAtPath:from toPath:tmp error:nil] && !rename(tmp.fileSystemRepresentation, conf.fileSystemRepresentation);
+            if (!ok) { [fm removeItemAtPath:tmp error:nil]; DBRED("cannot store the Dropbox settings"); }
+            else {
+                [fm setAttributes:@{NSFilePosixPermissions: @0600} ofItemAtPath:conf error:nil];
+                if (![fm removeItemAtPath:from error:nil]) DBRED("the settings are stored, but Documents/dropbox.txt cannot be removed: remove it, it holds the token");
+                DBLOG("Dropbox settings taken in");
+            }
+        }
+    }
+    g_app_key = g_refresh = nil;
+    const char *v = getenv("DM_SAVE_SYNC");
+    if ((v && !strcmp(v, "0")) || !conf_read(conf)) return;
+    // A local path: save_sync.c makes its parent folders, and only its end, <title ID>/save.dmsync, names the file. It wins over the folder picked in Cloud saves (dm_cloud_saves_env leaves an env value)
+    setenv("DM_SAVE_SYNC", [g_dir stringByAppendingPathComponent:@"cloud"].fileSystemRepresentation, 1);
+    g_on = YES;
+    DBLOG("through the Dropbox API");
+}
+
+BOOL dm_dropbox_enabled(void) {
+    static dispatch_once_t once; dispatch_once(&once, ^{ setup(); });
+    return g_on;
+}
+
+// ---------- requests ----------
+@interface DmDropboxSession : NSObject <NSURLSessionTaskDelegate>
+@end
+@implementation DmDropboxSession
+// No redirect is followed: the request carries the token, and Dropbox's API does not redirect
+- (void)URLSession:(NSURLSession *)s task:(NSURLSessionTask *)t willPerformHTTPRedirection:(NSHTTPURLResponse *)r newRequest:(NSURLRequest *)q completionHandler:(void (^)(NSURLRequest *))done { done(nil); }
+@end
+
+static NSURLSession *session(void) {
+    static NSURLSession *s; static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        NSURLSessionConfiguration *c = NSURLSessionConfiguration.ephemeralSessionConfiguration;
+        c.timeoutIntervalForRequest = REQUEST_S; c.timeoutIntervalForResource = RESOURCE_S; c.waitsForConnectivity = NO; c.URLCache = nil; c.requestCachePolicy = NSURLRequestReloadIgnoringLocalCacheData;
+        s = [NSURLSession sessionWithConfiguration:c delegate:[DmDropboxSession new] delegateQueue:nil];
+    });
+    return s;
+}
+
+// The status code, 0 when the request failed. Called off the main thread
+static NSInteger send(NSURLRequest *q, NSString *body_file, NSData **out) {
+    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+    __block NSInteger code = 0; __block NSData *got = nil;
+    void (^done)(NSData *, NSURLResponse *, NSError *) = ^(NSData *d, NSURLResponse *r, NSError *e) {
+        if (!e && [r isKindOfClass:NSHTTPURLResponse.class]) { code = ((NSHTTPURLResponse *)r).statusCode; got = d; }
+        else if (e) DBLOG("Dropbox: %s (%ld)", e.domain.UTF8String, (long)e.code);   // the domain and code only: the description may quote the request
+        dispatch_semaphore_signal(sem);
+    };
+    NSURLSessionTask *t = body_file ? [session() uploadTaskWithRequest:q fromFile:[NSURL fileURLWithPath:body_file] completionHandler:done] : [session() dataTaskWithRequest:q completionHandler:done];
+    [t resume];
+    dispatch_semaphore_wait(sem, DISPATCH_TIME_FOREVER);
+    if (out) *out = got;
+    return code;
+}
+
+static NSString *form(NSString *v) {
+    NSMutableCharacterSet *ok = NSCharacterSet.alphanumericCharacterSet.mutableCopy; [ok addCharactersInString:@"-._~"];
+    return [v stringByAddingPercentEncodingWithAllowedCharacters:ok];
+}
+
+static NSString *access_token(BOOL again) {
+    @synchronized (NSURLSession.class) {
+        if (!again && g_access && g_access_until.timeIntervalSinceNow > 60) return g_access;
+        g_access = nil;
+        NSMutableURLRequest *q = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:@DM_DROPBOX_API "/oauth2/token"]];
+        q.HTTPMethod = @"POST"; [q setValue:@"application/x-www-form-urlencoded" forHTTPHeaderField:@"Content-Type"];
+        q.HTTPBody = [[NSString stringWithFormat:@"grant_type=refresh_token&refresh_token=%@&client_id=%@", form(g_refresh), form(g_app_key)] dataUsingEncoding:NSUTF8StringEncoding];
+        NSData *d = nil; NSInteger code = send(q, nil, &d);
+        NSDictionary *o = code == 200 && d ? [NSJSONSerialization JSONObjectWithData:d options:0 error:nil] : nil;
+        NSString *t = [o isKindOfClass:NSDictionary.class] ? o[@"access_token"] : nil;
+        if (![t isKindOfClass:NSString.class] || !t.length) { DBRED("Dropbox gave no access token (HTTP %ld)", (long)code); return nil; }
+        NSNumber *life = o[@"expires_in"];
+        g_access = t; g_access_until = [NSDate dateWithTimeIntervalSinceNow:[life isKindOfClass:NSNumber.class] ? life.doubleValue : 3600];
+        return t;
+    }
+}
+
+// A header holds ASCII only, so anything else in the JSON goes as \uXXXX (Dropbox's rule for Dropbox-API-Arg)
+static NSString *api_arg(NSDictionary *o) {
+    NSString *json = [[NSString alloc] initWithData:[NSJSONSerialization dataWithJSONObject:o options:NSJSONWritingWithoutEscapingSlashes error:nil] encoding:NSUTF8StringEncoding];
+    NSMutableString *s = [NSMutableString string];
+    for (NSUInteger i = 0; i < json.length; i++) { unichar c = [json characterAtIndex:i]; if (c < 0x7f) [s appendFormat:@"%C", c]; else [s appendFormat:@"\\u%04x", c]; }
+    return s;
+}
+
+static NSInteger content_call(NSString *call, NSDictionary *arg, NSString *body_file, NSData **out) {
+    for (int attempt = 0; attempt < 2; attempt++) {   // a token Dropbox refuses (expired early, revoked) is asked for again once
+        NSString *token = access_token(attempt > 0);
+        if (!token) return 0;
+        NSMutableURLRequest *q = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:[@DM_DROPBOX_CONTENT stringByAppendingString:call]]];
+        q.HTTPMethod = @"POST";
+        [q setValue:[@"Bearer " stringByAppendingString:token] forHTTPHeaderField:@"Authorization"];
+        [q setValue:api_arg(arg) forHTTPHeaderField:@"Dropbox-API-Arg"];
+        [q setValue:@"application/octet-stream" forHTTPHeaderField:@"Content-Type"];
+        NSInteger code = send(q, body_file, out);
+        if (code != 401) return code;
+    }
+    return 401;
+}
+
+// 1 = written to `to`, 0 = no such file in Dropbox, -1 = cannot be read now
+static int download(NSString *path, NSString *to) {
+    NSData *d = nil; NSInteger code = content_call(@"/2/files/download", @{@"path": path}, nil, &d);
+    if (code == 200 && d) return [d writeToFile:to options:NSDataWritingAtomic error:nil] ? 1 : -1;
+    if (code == 409 && d) {
+        NSDictionary *o = [NSJSONSerialization JSONObjectWithData:d options:0 error:nil];
+        NSString *why = [o isKindOfClass:NSDictionary.class] ? o[@"error_summary"] : nil;
+        if ([why isKindOfClass:NSString.class] && [why hasPrefix:@"path/not_found"]) return 0;
+    }
+    if (code) DBRED("reading the save from Dropbox failed (HTTP %ld)", (long)code);
+    return -1;
+}
+
+static NSString *title_id(void) { return [@DM_GAME_ID uppercaseString]; }
+static NSString *cloud_path(void) { return [NSString stringWithFormat:@"%@/%@/save.dmsync", g_folder, title_id()]; }
+
+// ---------- the check ----------
+static dispatch_queue_t queue(void) {
+    static dispatch_queue_t q; static dispatch_once_t once;
+    dispatch_once(&once, ^{ q = dispatch_queue_create("dm.dropbox.check", DISPATCH_QUEUE_SERIAL); });
+    return q;
+}
+
+static NSString *when(int64_t t) {
+    NSDateFormatter *f = [NSDateFormatter new]; f.dateStyle = NSDateFormatterShortStyle; f.timeStyle = NSDateFormatterShortStyle;
+    return [f stringFromDate:[NSDate dateWithTimeIntervalSince1970:(NSTimeInterval)t]];
+}
+
+static NSInteger check_now(NSString **text) {
+    NSString *file = [g_dir stringByAppendingPathComponent:@"check.dmsync"];
+    [NSFileManager.defaultManager removeItemAtPath:file error:nil];
+    int got = download(cloud_path(), file);
+    ss_meta cloud = {0}, here = {0};
+    const char *save = getenv("DM_SAVE");
+    BOOL have_here = save && !ss_scan(save, &here) && here.files;
+    if (got == 1 && ss_read(file.fileSystemRepresentation, NULL, &cloud)) { DBRED("the save in Dropbox is damaged"); got = -1; }
+    else if (got == 1 && strcasecmp(cloud.title, title_id().UTF8String)) { DBRED("the save in Dropbox is %s's, not this game's", cloud.title); got = -1; }
+    @synchronized (NSURLSession.class) { g_pre = got; g_pre_file = got == 1 ? file : nil; }
+    if (got < 0) *text = L(@"Cloud save: unavailable", @"Облачный сейв: недоступен");
+    else if (!got) *text = have_here ? L(@"Cloud save: none yet; this device's goes up after a save", @"Облачного сейва ещё нет; сейв этого устройства уйдёт после сохранения") : L(@"Cloud save: none yet", @"Облачного сейва ещё нет");
+    else {
+        NSString *rel = !have_here ? L(@"nothing on this device", @"на этом устройстве сейва нет")
+                      : !strcmp(here.hash, cloud.hash) ? L(@"same as on this device", @"совпадает с этим устройством")
+                      : cloud.saved > here.saved ? L(@"newer than on this device", @"новее, чем на этом устройстве") : L(@"older than on this device", @"старее, чем на этом устройстве");
+        *text = [NSString stringWithFormat:L(@"Cloud save: available\n%s, %@\n%@", @"Облачный сейв: доступен\n%s, %@\n%@"), cloud.device, when(cloud.saved), rel];
+    }
+    return got;
+}
+
+void dm_dropbox_check(void (^done)(NSInteger, NSString *)) {
+    if (!dm_dropbox_enabled()) return;
+    dispatch_async(queue(), ^{
+        NSString *text = nil; NSInteger state = check_now(&text);
+        dispatch_async(dispatch_get_main_queue(), ^{ done(state, text); });
+    });
+}
+
+// ---------- the transport ----------
+int dm_dropbox_fetch(const char *cloud, const char *local) {
+    @autoreleasepool {
+        NSInteger pre; NSString *file;
+        @synchronized (NSURLSession.class) { pre = g_pre; file = g_pre_file; g_pre = PRE_NONE; g_pre_file = nil; }
+        NSString *to = @(local);
+        if (pre == PRE_NONE) return download(cloud_path(), to);   // not the first mount: the sender's own look, always fresh
+        if (pre != 1) return (int)pre;
+        NSFileManager *fm = NSFileManager.defaultManager;
+        [fm removeItemAtPath:to error:nil];
+        return [fm copyItemAtPath:file toPath:to error:nil] ? 1 : -1;
+    }
+}
+
+int dm_dropbox_store(const char *local, const char *cloud) {
+    @autoreleasepool {
+        NSInteger code = content_call(@"/2/files/upload", @{@"path": cloud_path(), @"mode": @"overwrite", @"autorename": @NO, @"mute": @YES}, @(local), NULL);
+        if (code == 200) return 1;
+        if (code) DBRED("sending the save to Dropbox failed (HTTP %ld)", (long)code);
+        return 0;
+    }
+}
+
+// ---------- the dialog at Play ----------
+#if __has_include(<UIKit/UIKit.h>)
+BOOL dm_dropbox_gate(UIViewController *vc, void (^go)(void), void (^back)(void)) {
+    static BOOL passed;
+    if (passed || !dm_dropbox_enabled()) return YES;
+    UIAlertController *wait = [UIAlertController alertControllerWithTitle:L(@"Checking the cloud save…", @"Проверяю облачный сейв…") message:nil preferredStyle:UIAlertControllerStyleAlert];
+    [vc presentViewController:wait animated:NO completion:nil];
+    dm_dropbox_check(^(NSInteger state, NSString *text) {
+        [wait dismissViewControllerAnimated:NO completion:^{
+            if (state >= 0) { passed = YES; go(); return; }
+            UIAlertController *a = [UIAlertController alertControllerWithTitle:L(@"Cloud save unavailable", @"Облачный сейв недоступен")
+                message:L(@"It could not be downloaded, so the game would start with this device's save, which may be older. If you then save, it may replace the one in the cloud (a copy stays in save-backups). Continue?",
+                          @"Его не удалось скачать, поэтому игра запустится с сейвом этого устройства, а он может быть старее. Если потом сохраниться, он может заменить сейв в облаке (копия останется в save-backups). Продолжить?")
+                preferredStyle:UIAlertControllerStyleAlert];
+            [a addAction:[UIAlertAction actionWithTitle:L(@"No", @"Нет") style:UIAlertActionStyleCancel handler:^(UIAlertAction *x) { back(); }]];
+            [a addAction:[UIAlertAction actionWithTitle:L(@"Yes", @"Да") style:UIAlertActionStyleDestructive handler:^(UIAlertAction *x) { DBLOG("the player started without the cloud save"); passed = YES; go(); }]];
+            [vc presentViewController:a animated:NO completion:nil];
+        }];
+    });
+    return NO;
+}
+#endif
